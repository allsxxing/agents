From 1b819101607bdfdea197051ae5b84a4b318f54b9 Mon Sep 17 00:00:00 2001
From: GJ Bordallo <gjbordallo@icloud.com>
Date: Tue, 4 Aug 2026 07:35:27 +0000
Subject: [PATCH 1/2] feat: add NFL_MCP_DISABLED_TOOLS registration allowlist

Adds an opt-in env var that suppresses MCP registration of named tools
without removing them from the codebase.

get_all_tools() filters its returned list by fn.__name__, which is the
same name server.py's mcp.tool(fn) loop infers for registration. The
underlying functions stay importable, so analytics tools that import
sleeper_tools directly (draft_tools, waiver_tools, sos_tools, ...) are
unaffected.

Unknown names are ignored, so a typo degrades to a no-op.
---
 nfl_mcp/tool_registry.py     | 32 ++++++++++++-
 tests/test_tool_allowlist.py | 90 ++++++++++++++++++++++++++++++++++++
 2 files changed, 121 insertions(+), 1 deletion(-)
 create mode 100644 tests/test_tool_allowlist.py

diff --git a/nfl_mcp/tool_registry.py b/nfl_mcp/tool_registry.py
index 317a82f..1e30a16 100644
--- a/nfl_mcp/tool_registry.py
+++ b/nfl_mcp/tool_registry.py
@@ -8,6 +8,7 @@ of a mutable global, eliminating race conditions and making the code testable.
 """
 from __future__ import annotations
 
+import os
 from collections.abc import Callable
 from contextvars import ContextVar
 
@@ -62,8 +63,32 @@ def get_db() -> NFLDatabase | None:
     """Return the current request's database instance (or None)."""
     return _db_token.get()
 
+def disabled_tools() -> set[str]:
+    """Tool names to skip during MCP registration.
+
+    Set via NFL_MCP_DISABLED_TOOLS as a comma-separated list of tool names, e.g.
+    ``NFL_MCP_DISABLED_TOOLS="get_league,get_rosters"``. Useful when another MCP
+    server already answers the same question and you don't want the model to see
+    two tools for it.
+
+    This filters the list returned by :func:`get_all_tools` ONLY — ``server.py``
+    iterates that list and calls ``mcp.tool(fn)`` per entry, inferring the
+    registered name from ``fn.__name__``. The underlying functions remain
+    importable and callable, which is how analytics tools (draft board,
+    projections, …) reach the Sleeper helpers: they import ``sleeper_tools``
+    directly, not through this registry.
+
+    Unknown names are ignored, so a typo degrades to a no-op rather than an error.
+    """
+    raw = os.environ.get("NFL_MCP_DISABLED_TOOLS", "")
+    return {name.strip() for name in raw.split(",") if name.strip()}
+
+
 def get_all_tools() -> list[Callable]:
-    """Get list of all tool functions to register with FastMCP server."""
+    """Get list of all tool functions to register with FastMCP server.
+
+    Honors the NFL_MCP_DISABLED_TOOLS allowlist; see :func:`disabled_tools`.
+    """
     tools = [
         # NFL News and Info
         get_nfl_news,
@@ -188,6 +213,11 @@ def get_all_tools() -> list[Callable]:
     if FEATURE_LEAGUE_LEADERS:
         tools.append(get_league_leaders)
 
+    # Suppress registration of any tool named in NFL_MCP_DISABLED_TOOLS.
+    skip = disabled_tools()
+    if skip:
+        tools = [t for t in tools if t.__name__ not in skip]
+
     return tools
 
 
diff --git a/tests/test_tool_allowlist.py b/tests/test_tool_allowlist.py
new file mode 100644
index 0000000..8b3d65e
--- /dev/null
+++ b/tests/test_tool_allowlist.py
@@ -0,0 +1,90 @@
+"""Tests for the NFL_MCP_DISABLED_TOOLS registration allowlist.
+
+The allowlist suppresses MCP *registration* only. The underlying functions stay
+importable and callable, because analytics tools (draft board, projections, …)
+reach the Sleeper helpers by importing them directly rather than through the
+registry.
+"""
+from nfl_mcp import tool_registry
+
+# The six Sleeper league-state tools that duplicate the Flaim MCP server.
+DUPLICATE_TOOLS = [
+    "get_league",
+    "get_rosters",
+    "get_matchups",
+    "get_transactions",
+    "get_user",
+    "get_user_leagues",
+]
+
+
+def test_disabled_tools_env_unset(monkeypatch):
+    monkeypatch.delenv("NFL_MCP_DISABLED_TOOLS", raising=False)
+    assert tool_registry.disabled_tools() == set()
+
+
+def test_disabled_tools_env_empty_string(monkeypatch):
+    monkeypatch.setenv("NFL_MCP_DISABLED_TOOLS", "")
+    assert tool_registry.disabled_tools() == set()
+
+
+def test_disabled_tools_env_parses_list(monkeypatch):
+    monkeypatch.setenv("NFL_MCP_DISABLED_TOOLS", "get_league,get_rosters")
+    assert tool_registry.disabled_tools() == {"get_league", "get_rosters"}
+
+
+def test_disabled_tools_strips_whitespace_and_blanks(monkeypatch):
+    monkeypatch.setenv("NFL_MCP_DISABLED_TOOLS", " get_league , get_rosters ,,  ")
+    assert tool_registry.disabled_tools() == {"get_league", "get_rosters"}
+
+
+def test_get_all_tools_unfiltered_by_default(monkeypatch):
+    """With the env var unset, every tool is registered as before."""
+    monkeypatch.delenv("NFL_MCP_DISABLED_TOOLS", raising=False)
+    names = {fn.__name__ for fn in tool_registry.get_all_tools()}
+    assert set(DUPLICATE_TOOLS) <= names
+
+
+def test_get_all_tools_excludes_disabled(monkeypatch):
+    """The registration list itself must omit disabled tools — this is what
+    server.py iterates over, so filtering here is sufficient and correct."""
+    monkeypatch.setenv("NFL_MCP_DISABLED_TOOLS", ",".join(DUPLICATE_TOOLS))
+    names = {fn.__name__ for fn in tool_registry.get_all_tools()}
+    assert not (set(DUPLICATE_TOOLS) & names)
+    # Draft/analytics tools are unaffected and still registered.
+    assert {"get_draft_board", "recommend_draft_pick", "simulate_draft"} <= names
+
+
+def test_unknown_names_are_ignored(monkeypatch):
+    """A typo in the env var must not drop real tools or raise."""
+    monkeypatch.delenv("NFL_MCP_DISABLED_TOOLS", raising=False)
+    baseline = {fn.__name__ for fn in tool_registry.get_all_tools()}
+    monkeypatch.setenv("NFL_MCP_DISABLED_TOOLS", "not_a_real_tool")
+    assert {fn.__name__ for fn in tool_registry.get_all_tools()} == baseline
+
+
+def test_registry_wrappers_survive_decoration(monkeypatch):
+    """Filtering keys off fn.__name__, which must survive @timing_decorator —
+    server.py's mcp.tool(fn) infers the registered name the same way."""
+    monkeypatch.delenv("NFL_MCP_DISABLED_TOOLS", raising=False)
+    names = [fn.__name__ for fn in tool_registry.get_all_tools()]
+    assert "wrapper" not in names
+    assert len(names) == len(set(names)), "duplicate tool names in registry"
+
+
+def test_sleeper_module_still_importable_when_disabled(monkeypatch):
+    """Analytics tools import sleeper_tools directly (not via the registry),
+    so disabling MCP registration must not make the module unavailable."""
+    monkeypatch.setenv("NFL_MCP_DISABLED_TOOLS", ",".join(DUPLICATE_TOOLS))
+    tool_registry.get_all_tools()
+    from nfl_mcp import sleeper_tools
+
+    assert hasattr(sleeper_tools, "get_rosters")
+    assert hasattr(sleeper_tools, "get_league")
+
+
+def test_disabled_registry_wrapper_still_callable(monkeypatch):
+    """The suppressed wrapper itself remains a live attribute of the module."""
+    monkeypatch.setenv("NFL_MCP_DISABLED_TOOLS", "get_rosters")
+    assert "get_rosters" not in {fn.__name__ for fn in tool_registry.get_all_tools()}
+    assert callable(tool_registry.get_rosters)
